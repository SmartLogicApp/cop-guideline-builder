{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "prebuild": "pnpm --dir ../.. run test:startup-probe-contract && pnpm run test:startup-schema-safety",
    "build": "node ./build.mjs && pnpm --dir ../.. run test:api-readiness-smoke",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "node --test src/**/*.test.ts",
    "test:seo-sitemap": "node --test src/routes/sitemap-contract.test.mjs",
    "test:generation": "node --test src/services/generation.test.ts",
    "test:startup-schema-safety": "node --test src/lib/startup-schema-safety.test.ts src/lib/payment-config.test.ts src/lib/stripe-billing-contract.test.ts src/lib/affiliate-application-acceptance.test.ts src/lib/affiliate-referral-code.test.ts src/routes/sitemap-contract.test.mjs src/services/generation.test.ts && pnpm --dir ../.. run test:gap-history",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:cache": "node --experimental-transform-types --test src/lib/durable-cache.test.ts",
    "test:ccn": "node --experimental-transform-types --test src/lib/ccn-lookup.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.52",
    "@clerk/shared": "^4.27.1",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/cms-compliance-data": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
