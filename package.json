{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "pretest:browser": "playwright install chromium",
    "test:browser": "playwright test",
    "pretest:marketing-browser-boundary": "playwright install chromium",
    "test:marketing-browser-boundary": "playwright test tests/browser/public-bundle-boundary.spec.ts --project=marketing-auth-chromium --project=marketing-auth-prefixed-chromium",
    "validate:marketing-release": "pnpm run test:marketing-build-credential-contract && pnpm run test:marketing-browser-boundary",
    "typecheck:libs": "tsc --build",
    "typecheck": "sh -c 'pnpm run check:browser-tsconfig-contract; contract_status=$?; pnpm run typecheck:libs; libs_status=$?; pnpm -r --no-bail --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck; leaves_status=$?; if [ \"$contract_status\" -ne 0 ] || [ \"$libs_status\" -ne 0 ] || [ \"$leaves_status\" -ne 0 ]; then exit 1; fi'",
    "check:browser-tsconfig-contract": "node scripts/check-browser-tsconfig-contract.mjs",
    "test:browser-tsconfig-contract": "node --test scripts/check-browser-tsconfig-contract.test.mjs && pnpm run check:browser-tsconfig-contract",
    "check:canvas-release-contract": "node scripts/check-canvas-release-contract.mjs",
    "test:canvas-release-contract": "node --test scripts/check-canvas-release-contract.test.mjs scripts/validate-canvas-changes.test.mjs && pnpm run check:canvas-release-contract",
    "check:marketing-build-credential-contract": "node scripts/check-marketing-build-credential-contract.mjs",
    "test:marketing-build-credential-contract": "node --test scripts/check-marketing-build-credential-contract.test.mjs && pnpm run check:marketing-build-credential-contract",
    "check:startup-probe-contract": "node scripts/check-startup-probe-contract.mjs",
    "test:startup-probe-contract": "node --test scripts/check-startup-probe-contract.test.mjs && pnpm run check:startup-probe-contract",
    "test:api-readiness-smoke": "node --test scripts/api-readiness-smoke.test.mjs",
    "test:canvas-paths": "node --test scripts/validate-canvas-changes.test.mjs",
    "validate:canvas": "pnpm install --frozen-lockfile && pnpm --filter @workspace/mockup-sandbox run typecheck && PORT=4173 BASE_PATH=/__mockup NODE_ENV=production pnpm --filter @workspace/mockup-sandbox run build",
    "validate:canvas:changed": "node scripts/validate-canvas-changes.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/cms-compliance-data": "workspace:*",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "react": "catalog:"
  },
  "devDependencies": {
    "@clerk/backend": "^3.17.1",
    "@clerk/testing": "^2.2.33",
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
      "brace-expansion@5.0.8": "5.0.9",
      "fast-uri@3.1.4": "3.1.7",
      "js-yaml": "4.1.1",
      "nanoid": ">=3.3.18",
      "qs@6.15.3": "6.16.0",
      "uuid@8.3.2": "11.1.1",
      "vite>esbuild": "0.28.2"
    }
  }
}
